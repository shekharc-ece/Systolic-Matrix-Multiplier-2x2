`timescale 1ns/1ps

module matrix_B (
    input clk,
    input reset,
    input load_B,

    input [3:0] b00,
    input [3:0] b01,
    input [3:0] b10,
    input [3:0] b11,

    output reg [3:0] B00,
    output reg [3:0] B01,
    output reg [3:0] B10,
    output reg [3:0] B11
);

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        B00 <= 0;
        B01 <= 0;
        B10 <= 0;
        B11 <= 0;
    end

    else if (load_B)
    begin
        B00 <= b00;
        B01 <= b01;
        B10 <= b10;
        B11 <= b11;
    end
end

endmodule
