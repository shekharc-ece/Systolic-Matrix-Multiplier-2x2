`timescale 1ns/1ps

module matrix_A (
    input clk,
    input reset,
    input load_A,

  input [3:0] a00,
  input [3:0] a01,
  input [3:0] a10,
  input [3:0] a11,

  output reg [3:0] A00,
  output reg [3:0] A01,
  output reg [3:0] A10,
  output reg [3:0] A11
);

always @(posedge clk or posedge reset)
begin
    if (reset)
    begin
        A00 <= 0;
        A01 <= 0;
        A10 <= 0;
        A11 <= 0;
    end
  else if (load_A)
    begin
        A00 <= a00;
        A01 <= a01;
        A10 <= a10;
        A11 <= a11;
    end
end

endmodule
